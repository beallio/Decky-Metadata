export TMPDIR="${TMPDIR:-/var/tmp/omp-1000}"
mkdir -p -m 0700 -- "$TMPDIR"
export XDG_CACHE_HOME="$TMPDIR/.cache"
export npm_config_cache="$TMPDIR/.npm"
export PYTHONPYCACHEPREFIX="$TMPDIR/__pycache__"
export UV_CACHE_DIR="$TMPDIR/.uv"
export CARGO_HOME="${CARGO_HOME:-$TMPDIR/cargo-home}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$TMPDIR/cargo-target/Decky-Metadata}"
