#!/usr/bin/env bash
# Project quality gates. Invoked from the repository root.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ -f package.json ]]; then
  if [[ ! -d node_modules ]]; then
    if [[ -f pnpm-lock.yaml ]] && command -v pnpm >/dev/null 2>&1; then
      ./run.sh pnpm install --frozen-lockfile
    else
      ./run.sh npm ci
    fi
  fi

  ./run.sh npx tsc --noEmit
  ./run.sh npm run build
  ./run.sh npm test
fi

./run.sh npm run test:backend
./run.sh npm run build:backend
./run.sh cargo build --locked --manifest-path backend-rust/Cargo.toml --bin backend-diagnostics
./run.sh node --test tests/package_mjs_test.mjs
./run.sh python3 -m py_compile main.py
./run.sh uv run --with pytest -- pytest -q
./run.sh npm run package

if [[ -f package.json && -f scripts/version_guard.py ]]; then
  base_version="$(node -p "require('./package.json').version")"
  ./run.sh python3 scripts/version_guard.py check-drift "$base_version"
fi

echo "quality-gates: OK"
