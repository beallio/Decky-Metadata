{
  "name": "decky-metadata",
  "version": "0.5.5",
  "description": "Add game metadata, Steam activity news, and Steam community controller layouts to non-Steam games in Steam Gaming Mode.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:backend": "./run.sh node ./scripts/build_backend.mjs",
    "test:backend": "./run.sh cargo test --locked --manifest-path backend-rust/Cargo.toml",
    "watch": "rollup -c -w",
    "package": "./run.sh npm run build && ./run.sh node ./scripts/package.mjs",
    "package:linux": "./run.sh npm run build && ./run.sh node ./scripts/package.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam",
    "metadata",
    "non-steam"
  ],
  "author": "beallio",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "mobx": "6.16.1",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "overrides": {
    "@decky/rollup": {
      "@rollup/plugin-commonjs": "^29.0.3",
      "rollup-plugin-delete": "^3.0.2"
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
